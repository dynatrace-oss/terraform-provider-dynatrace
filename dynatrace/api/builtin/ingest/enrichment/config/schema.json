{
	"allowedScopes": [
		"HOST",
		"KUBERNETES_CLUSTER",
		"HOST_GROUP",
		"AWS_ACCOUNT",
		"AZURE_MICROSOFT_RESOURCES_SUBSCRIPTIONS",
		"GCP_PROJECT",
		"environment"
	],
	"constraints": [
